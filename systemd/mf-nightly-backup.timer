[Unit]
Description=MandarinFlash Nightly Backup Timer

[Timer]
# Run daily at 3:17 AM Pacific Time
# Server runs UTC, so we specify the timezone explicitly
OnCalendar=*-*-* 03:17:00 America/Los_Angeles

# If system was down at scheduled time, run at next boot
Persistent=true

[Install]
WantedBy=timers.target

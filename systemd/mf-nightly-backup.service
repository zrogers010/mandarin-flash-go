[Unit]
Description=MandarinFlash Nightly Database Backup
After=network.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=deploy
ExecStart=/home/deploy/bin/mf-nightly-backup.sh
StandardOutput=journal
StandardError=journal

# Ensure backup completes within reasonable time
TimeoutStartSec=15min

[Install]
WantedBy=multi-user.target
